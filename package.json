{
  "name": "gitflow-sentinel",
  "version": "3.0.0-alpha.1",
  "description": "Cross-agent project-foundation orchestrator with inspection, immutable plans, transactional apply/rollback, Git policy, CI, documentation, security, and GitHub adapters.",
  "type": "module",
  "bin": {
    "gitflow-sentinel": "scripts/cli.mjs"
  },
  "license": "MIT",
  "author": "Aurele Gnonlonfoun (@AureleDev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AureleDev/gitflow-sentinel.git"
  },
  "keywords": [
    "git",
    "github",
    "git-hooks",
    "branch-protection",
    "pre-commit",
    "conventional-commits",
    "secret-scanning",
    "gitflow",
    "trunk-based",
    "codex",
    "claude-code",
    "ai-agents",
    "husky-alternative"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs && node --test tests/*.test.mjs",
    "verify:foundations": "node scripts/foundation-verify.mjs --project-root .",
    "install:guardrails": "node scripts/orchestrate.mjs",
    "validate:evals": "node scripts/validate-evals.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "validate:self-host": "node scripts/validate-self-host.mjs",
    "validate:projects": "node scripts/validate-project-matrix.mjs"
  },
  "files": [
    "SKILL.md",
    "scripts/",
    "references/",
    "assets/",
    "agents/",
    "skills/",
    ".codex-plugin/",
    "evals/",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {}
}
